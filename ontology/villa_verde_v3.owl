<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/ontologies/2026/villa_verde#"
     xml:base="http://www.semanticweb.org/ontologies/2026/villa_verde"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">
    <owl:Ontology rdf:about="http://www.semanticweb.org/ontologies/2026/villa_verde">
        <rdfs:label xml:lang="es">Ontología de Gestión de Residuos Villa Verde v3 · Manizales, Caldas</rdfs:label>
        <rdfs:comment xml:lang="es">Modelo conceptual y grafo de conocimiento alineado al 100% con la base de datos operativa de Manizales, Caldas (comunas, veredas y nodos de referencia como Mall Plaza, Plaza de Bolívar y Torre del Cable).</rdfs:comment>
    </owl:Ontology>

    <!-- ======================================================== -->
    <!-- CLASSES (T-BOX)                                          -->
    <!-- ======================================================== -->

    <owl:Class rdf:about="#Residuo">
        <rdfs:label xml:lang="es">Residuo</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="#ResiduoOrdinario">
        <rdfs:subClassOf rdf:resource="#Residuo"/>
        <rdfs:label xml:lang="es">Residuo Ordinario</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="#ResiduoRAEE">
        <rdfs:subClassOf rdf:resource="#Residuo"/>
        <rdfs:label xml:lang="es">Residuo RAEE</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="#TipoRAEE">
        <rdfs:label xml:lang="es">Tipo RAEE</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="#TipoRAEEPeligroso">
        <rdfs:subClassOf rdf:resource="#TipoRAEE"/>
        <rdfs:label xml:lang="es">Tipo RAEE Peligroso</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="#Zona">
        <rdfs:label xml:lang="es">Zona</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="#ComunaUrbana">
        <rdfs:subClassOf rdf:resource="#Zona"/>
        <rdfs:label xml:lang="es">Comuna Urbana</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="#Corregimiento">
        <rdfs:subClassOf rdf:resource="#Zona"/>
        <rdfs:label xml:lang="es">Corregimiento</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="#Vereda">
        <rdfs:subClassOf rdf:resource="#Zona"/>
        <rdfs:label xml:lang="es">Vereda</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="#ZonaDesatendida">
        <rdfs:subClassOf rdf:resource="#Zona"/>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="#Zona"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="#diasSinServicio"/>
                        <owl:someValuesFrom>
                            <rdfs:Datatype>
                                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
                                <owl:withRestrictions rdf:parseType="Collection">
                                    <rdf:Description>
                                        <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</xsd:minInclusive>
                                    </rdf:Description>
                                </owl:withRestrictions>
                            </rdfs:Datatype>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:label xml:lang="es">Zona desatendida</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="#ZonaVulnerable">
        <rdfs:subClassOf rdf:resource="#Zona"/>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="#Zona"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="#porcentajeVulnerable"/>
                        <owl:someValuesFrom>
                            <rdfs:Datatype>
                                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
                                <owl:withRestrictions rdf:parseType="Collection">
                                    <rdf:Description>
                                        <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">25.0</xsd:minInclusive>
                                    </rdf:Description>
                                </owl:withRestrictions>
                            </rdfs:Datatype>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:label xml:lang="es">Zona vulnerable</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="#PuntoAcopio">
        <rdfs:label xml:lang="es">Punto de acopio</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="#ContenedorOrdinario">
        <rdfs:subClassOf rdf:resource="#PuntoAcopio"/>
        <rdfs:label xml:lang="es">Contenedor Ordinario</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="#PuntoAcopioRAEE">
        <rdfs:subClassOf rdf:resource="#PuntoAcopio"/>
        <rdfs:label xml:lang="es">Punto Acopio RAEE</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="#PuntoSaturado">
        <rdfs:subClassOf rdf:resource="#PuntoAcopio"/>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="#PuntoAcopio"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="#porcentajeSaturacion"/>
                        <owl:someValuesFrom>
                            <rdfs:Datatype>
                                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
                                <owl:withRestrictions rdf:parseType="Collection">
                                    <rdf:Description>
                                        <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">80</xsd:minInclusive>
                                    </rdf:Description>
                                </owl:withRestrictions>
                            </rdfs:Datatype>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:label xml:lang="es">Punto saturado</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="#PuntoEnEntornoSensible">
        <rdfs:subClassOf rdf:resource="#PuntoAcopio"/>
        <rdfs:label xml:lang="es">Punto en Entorno Sensible</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="#PuntoCritico">
        <rdfs:subClassOf rdf:resource="#PuntoAcopio"/>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="#PuntoSaturado"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="#cercaDe"/>
                        <owl:someValuesFrom rdf:resource="#EquipamientoSensible"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:label xml:lang="es">Punto crítico</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="#Ruta">
        <rdfs:label xml:lang="es">Ruta</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="#Vehiculo">
        <rdfs:label xml:lang="es">Vehículo</rdfs:label>
