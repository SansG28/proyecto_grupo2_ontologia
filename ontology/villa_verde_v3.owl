    <!-- GESTORES EN MANIZALES -->
    <owl:NamedIndividual rdf:about="#Gestor_EMAS_Manizales">
        <rdf:type rdf:resource="#GestorAutorizado"/>
        <nombre rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EMAS by Veolia Manizales</nombre>
        <disponible rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</disponible>
        <estaAutorizado rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estaAutorizado>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#Gestor_EcoCaldas_RAEE">
        <rdf:type rdf:resource="#GestorAutorizado"/>
        <nombre rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EcoCaldas Gestor Autorizado RAEE</nombre>
