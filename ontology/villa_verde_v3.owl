    <owl:Class rdf:about="#EventoClimatico">
        <rdfs:label xml:lang="es">Evento climático</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="#Lluvia">
        <rdfs:subClassOf rdf:resource="#EventoClimatico"/>
        <rdfs:label xml:lang="es">Lluvia</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="#Deslizamiento">
        <rdfs:subClassOf rdf:resource="#EventoClimatico"/>
        <rdfs:label xml:lang="es">Deslizamiento</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="#QuejaCiudadana">
        <rdfs:label xml:lang="es">Queja ciudadana</rdfs:label>
